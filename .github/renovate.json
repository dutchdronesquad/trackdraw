{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "Europe/Amsterdam",
  "schedule": ["before 6am every weekday"],
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": false
  },
  "commitMessagePrefix": "⬆️",
  "packageRules": [
    {
      "groupName": "Radix UI",
      "groupSlug": "radix-ui",
      "matchPackageNames": ["@radix-ui/{/,}**"]
    },
    {
      "groupName": "Better Auth",
      "groupSlug": "better-auth",
      "matchPackageNames": ["better-auth", "@better-auth/{/,}**"]
    },
    {
      "groupName": "Vitest",
      "groupSlug": "vitest",
      "matchPackageNames": ["vitest", "@vitest/{/,}**"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"],
      "rangeStrategy": "pin",
      "extractVersion": "^(?<version>v\\d+\\.\\d+\\.\\d+)$",
      "versioning": "regex:^v(?<major>\\d+)(\\.(?<minor>\\d+)\\.(?<patch>\\d+))?$"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "groupName": "npm non-major dependencies",
      "groupSlug": "npm-non-major",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
