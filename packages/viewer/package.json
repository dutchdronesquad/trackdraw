{
  "name": "@trackdraw/viewer",
  "version": "0.1.0",
  "description": "Framework-neutral 2D/3D track viewer for TrackDraw course snapshots.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./mount": {
      "import": "./dist/mount.js"
    },
    "./snapshot/types": {
      "import": "./dist/snapshot/types.js"
    },
    "./snapshot/version": {
      "import": "./dist/snapshot/version.js"
    },
    "./snapshot/schema": {
      "import": "./dist/snapshot/schema.js"
    },
    "./assets/manifest": {
      "import": "./dist/assets/manifest.js"
    },
    "./assets/texture-paths": {
      "import": "./dist/assets/texture-paths.js"
    },
    "./assets/asset-url": {
      "import": "./dist/assets/asset-url.js"
    },
    "./static/trackdraw-viewer.css": "./dist/static/trackdraw-viewer.css"
  },
  "scripts": {
    "build": "node ../../scripts/generate_viewer_asset_manifest.mjs && tsup && node ../../scripts/build_viewer_css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "konva": "^10.0.2",
    "react-konva": "^19.2.3",
    "three": "^0.186.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.0"
  }
}
