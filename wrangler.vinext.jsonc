{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trackdraw-dev",
  "main": "./vinext-worker.ts",
  "compatibility_date": "2026-03-27",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
  ],
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "observability": { "enabled": true, "logs": { "invocation_logs": true } },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trackdraw-dev",
      "database_id": "8b9a4679-c919-4082-93d1-3841fa2bfc19",
    },
  ],
  "r2_buckets": [
    { "binding": "MEDIA_BUCKET", "bucket_name": "trackdraw-media" },
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://dev.trackdraw.app",
    "NEXT_PUBLIC_APP_ENV": "development",
    "PLUNK_FROM_EMAIL": "noreply@emails.trackdraw.app",
    "PLUNK_REPLY_TO_EMAIL": "info@trackdraw.app",
  },
}
